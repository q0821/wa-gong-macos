    "Dictated %@, %@ words from %@." : {
      "comment" : "Dashboard benchmark sentence. The first argument is the formatted dictated word count, the second is the remaining word count, and the third is the benchmark title.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ diktiert, %@ Wörter von %@ entfernt."
          }
        },
