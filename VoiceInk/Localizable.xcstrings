    },
    "'%@' is the default mode. Set another mode as default before deleting it." : {
      "comment" : "A warning alert that appears when the user tries to delete a mode that is set as the default mode. The argument is the name of the mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist der Standardmodus. Lege vor dem Löschen einen anderen Modus als Standard fest."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是默认模式。请先将其他模式设为默认模式，然后再删除它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是預設模式。請先將其他模式設為預設模式，然後再刪除它。"
          }
        }
