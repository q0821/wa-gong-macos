          "stringUnit" : {
            "state" : "new",
            "value" : "Dictated %1$@, %2$@ words from %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已听写 %@，还差 %@ 字即可达到 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已聽寫 %@，還差 %@ 字即可達到 %@。"
          }
        }
      }
    },
